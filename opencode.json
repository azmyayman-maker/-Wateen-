{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-chrome"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI=postgresql://username:password@localhost:5432/dbname",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ]
    }
  }
}