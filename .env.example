# DEBUG=False in production (required for security)
DEBUG=False
SECRET_KEY=replace-this-with-a-secure-key-at-least-32-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database
DB_NAME=wateen_db
DB_USER=wateen_user
DB_PASSWORD=wateen_password
DB_HOST=db
DB_PORT=5432

# =============================================================================
# Redis Configuration (Cloud or Local)
# =============================================================================
# Format: redis://[:password@]host[:port][/database]
# Examples:
#   Local:     redis://localhost:6379/0
#   Cloud:     redis://:your-password@redis-12345.cloud.redislabs.com:12345/0
#   TLS:       rediss://:password@secure-redis.example.com:6379/0
#
# Behavior:
#   - If not set and DEBUG=True: Uses in-memory cache (dev mode)
#   - If not set and DEBUG=False: Application fails to start (production)
#   - If set but unreachable: Falls back to in-memory (dev) or fails (prod)
# =============================================================================
REDIS_URL=
