# DEBUG=False in production (required for security)
DEBUG=False
SECRET_KEY=replace-this-with-a-secure-key-at-least-32-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database
DB_NAME=wateen_db
DB_USER=wateen_user
DB_PASSWORD=wateen_password
DB_HOST=db
DB_PORT=5432

# PostgreSQL Docker initialization
POSTGRES_USER=wateen_admin
POSTGRES_PASSWORD=wateen_secure_password_123
POSTGRES_DB=wateen_db

# =============================================================================
# Redis Configuration (Cloud or Local)
# =============================================================================
# Format: redis://[:password@]host[:port][/database]
# Examples:
#   Local:     redis://localhost:6379/0
#   Cloud:     redis://:your-password@redis-12345.cloud.redislabs.com:12345/0
#   TLS:       rediss://:password@secure-redis.example.com:6379/0
#
# Behavior:
#   - If not set and DEBUG=True: Uses in-memory cache (dev mode)
#   - If not set and DEBUG=False: Application fails to start (production)
#   - If set but unreachable: Falls back to in-memory (dev) or fails (prod)
# =============================================================================
REDIS_URL=

# =============================================================================
# B2B2C Payment — Paymob (Egyptian Payment Gateway)
# =============================================================================
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_HMAC_SECRET=your_hmac_secret
# =============================================================================
# Firebase Cloud Messaging (Push Notifications)
# =============================================================================
# Absolute path to Firebase service account key JSON file
# Download from Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=
# Firebase project ID (optional override)
FIREBASE_PROJECT_ID=
# Days after which inactive device tokens are cleaned up
NOTIFICATION_STALE_TOKEN_DAYS=30

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/1

# =============================================================================
# Routing Provider (osrm or ors)
# =============================================================================
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://router.project-osrm.org
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=your_ors_api_key
