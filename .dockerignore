# =============================================================================
# Docker Build Context Ignore File
# Excludes unnecessary files from Docker build context
# =============================================================================

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node.js / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.cache/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker/*.log
docker/docker_test_output_*.txt

# Environment files (should be mounted, not copied)
.env
.env.local
.env.*.local

# Test outputs
test_output*.txt
verification-report.json

# Documentation
docs/
*.md
!README.md

# Design system (not needed in container)
design-system/

# Agent/config files
.agent/
.kilocode/
.opencode/
.specify/

# Misc
*.log
*.tmp
*.temp
output.txt
