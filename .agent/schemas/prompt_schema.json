{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wateen.agent/schemas/prompt_schema.json",
  "title": "Task Prompt Schema",
  "description": "Schema for validating task prompt files in .agent/tasks/pending/",
  "type": "object",
  "required": ["title", "instructions"],
  "properties": {
    "ticket": {
      "type": "string",
      "description": "Ticket reference ID (e.g., '1.4-sync')"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable task title"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium",
      "description": "Task priority level"
    },
    "depends_on": {
      "type": "string",
      "description": "Reference to dependent ticket or task"
    },
    "estimated_complexity": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium",
      "description": "Estimated implementation complexity"
    },
    "instructions": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed implementation instructions"
    },
    "verification": {
      "type": "string",
      "description": "Steps to verify successful completion"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "low",
      "description": "Risk classification for automation approval"
    },
    "requires_approval": {
      "type": "boolean",
      "default": false,
      "description": "Whether manual approval is required before execution"
    },
    "files_to_modify": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of files expected to be modified"
    },
    "network_access": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of external hosts/domains required"
    }
  },
  "additionalProperties": true
}