# =============================================================================
# Wateen Project — .gitignore
# =============================================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual Environments ──
venv/
.venv/
env/

# ── Environment Variables ──
.env
!.env.example

# ── Database ──
db.sqlite3
*.sqlite3

# ── Django ──
staticfiles/
mediafiles/

# ── IDE / Editor ──
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
nul

# ── Docker ──
# (docker volumes are external, nothing to ignore here)


# ── OS ──
*.log
*.pid
*.seed

# ── Temporary Test & Debug Output ──
*_output.txt
test_errors.txt
test_failures*.txt
logs_dump.txt
remaining_tests.txt
error_log.txt
check_output.txt
