{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verification-report.json",
  "title": "Infrastructure Verification Report",
  "description": "Schema for infrastructure verification output",
  "type": "object",
  "required": ["timestamp", "overall_status", "total_duration_ms", "components"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of verification run"
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "fail"],
      "description": "Overall verification status"
    },
    "total_duration_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Total verification duration in milliseconds"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ComponentResult"
      },
      "description": "Map of component name to verification result"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary"
    },
    "environment": {
      "type": "object",
      "properties": {
        "branch": { "type": "string" },
        "hostname": { "type": "string" },
        "python_version": { "type": "string" }
      }
    }
  },
  "definitions": {
    "ComponentResult": {
      "type": "object",
      "required": ["component", "status", "latency_ms", "timestamp"],
      "properties": {
        "component": {
          "type": "string",
          "enum": ["database", "cache"],
          "description": "Component identifier"
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "warning"],
          "description": "Component verification status"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Operation latency in milliseconds"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of this check"
        },
        "details": {
          "type": "string",
          "description": "Human-readable details"
        },
        "error": {
          "type": "string",
          "description": "Error message if failed"
        }
      }
    },
    "DatabaseResult": {
      "allOf": [
        { "$ref": "#/definitions/ComponentResult" },
        {
          "type": "object",
          "properties": {
            "postgis_version": { "type": "string" },
            "crud_status": {
              "type": "object",
              "properties": {
                "create": { "type": "boolean" },
                "read": { "type": "boolean" },
                "delete": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "CacheResult": {
      "allOf": [
        { "$ref": "#/definitions/ComponentResult" },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "properties": {
                "set": { "type": "boolean" },
                "get": { "type": "boolean" },
                "delete": { "type": "boolean" }
              }
            },
            "pubsub_status": {
              "type": "object",
              "properties": {
                "subscribe": { "type": "boolean" },
                "publish": { "type": "boolean" },
                "receive": { "type": "boolean" }
              }
            }
          }
        }
      ]
    }
  }
}
